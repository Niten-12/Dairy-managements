# Production / APK build configuration.
#
# Copy to `.env.production` for a local production build. CI does NOT use this
# file — the APK workflow injects VITE_API_URL from the repository variable of
# the same name (Settings → Secrets and variables → Actions → Variables).
#
# Unlike the dev/web build, the APK has no same-origin backend to proxy to, so
# this MUST be an absolute, publicly reachable URL — not "/api".
VITE_API_URL=https://your-backend.up.railway.app/api

# Optional. Only needed when uploaded images are served from a different origin
# than the API (e.g. a CDN or object store). Left unset, media URLs are derived
# from VITE_API_URL by stripping the trailing "/api".
# VITE_MEDIA_BASE_URL=https://your-backend.up.railway.app
